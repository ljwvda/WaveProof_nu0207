close all

data = load('WaveProof_nu0207.mat');
phi0=data.x0;
%c=data.c; % this is already included in phi0
nu=data.nu;
solshape=data.solshape;
symmetry=data.symmetry;

forcing=classicforcingtensor;

%nu=intval(nu);

tic

%% Proof
parallel=false; % to force serial execution of the loop 
%parallel=true; % uses parfor (also runs without the parallel toolbox)

ref = phi0(1:end-1); % Exclude wave speed/Omega

%  Ntilde >= Ndagger (to ensure finite part A does not influence tail
%  estimate)
Ndagger = 50; % Size of the computational/finite part A
Ntilde = 70; % To balance the quality of the estimates and the computational costs
%300,700

% Estimate Ntilde
% Z1target=0.975;  %
% tildeNtarget=estimatetildeN_Wave(Z1target,x0,nu,forcing,ref,solshape,symmetry,eta,setup);

% eta=1;
% etac=1;

eta=1+1e-7;
etac=1+1e-7;
setup='not2D';

% run the proof
%disp('No intervals')
[success,rmin,rmax,bounds]=checkpolytensorsplit_ext_Wave(phi0,nu,forcing,ref,...
          solshape,symmetry,Ndagger,Ntilde,eta,etac,setup,parallel); 

toc